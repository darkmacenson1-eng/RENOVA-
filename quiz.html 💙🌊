const accueil = document.getElementById("home");
const jeu = document.getElementById("game");
const resultat = document.getElementById("result");
const categoriesContainer = document.getElementById("categories");

function melanger(tableau) {
  const copie = [...tableau];

  for (let i = copie.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copie[i], copie[j]] = [copie[j], copie[i]];
  }

  return copie;
}

function afficherCategories() {
  if (!categoriesContainer) return;

  categoriesContainer.innerHTML = "";

  Object.keys(questions).forEach(nom => {
    const bouton = document.createElement("button");
    bouton.className = "category-card";
    bouton.textContent = `${nom} (${questions[nom].length} questions)`;
    bouton.addEventListener("click", () => commencerPartie(nom));
    categoriesContainer.appendChild(bouton);
  });
}

function commencerPartie(nomCategorie) {
  if (!questions[nomCategorie] || questions[nomCategorie].length === 0) {
    alert("Cette catégorie ne contient aucune question.");
    return;
  }

  categorieActuelle = nomCategorie;
  questionsPartie = melanger(questions[nomCategorie]).slice(
    0,
    Math.min(QUESTIONS_PAR_PARTIE, questions[nomCategorie].length)
  );

  indexQuestion = 0;
  score = 0;
  reponsesJoueur = [];

  accueil.classList.add("hidden");
  resultat.classList.add("hidden");
  jeu.classList.remove("hidden");

  const titre = document.getElementById("category-title");
  if (titre) titre.textContent = nomCategorie;

  afficherQuestion();
}

function afficherQuestion() {
  clearInterval(chronometre);
  reponseVerrouillee = false;
  tempsRestant = TEMPS_PAR_QUESTION;

  const question = questionsPartie[indexQuestion];

  if (!question) {
    terminerPartie();
    return;
  }

  document.getElementById("question-number").textContent =
    `Question ${indexQuestion + 1}/${questionsPartie.length}`;

  document.getElementById("score").textContent = `Score : ${score}`;
  document.getElementById("question-text").textContent = question[0];

  const zoneReponses = document.getElementById("answers");
  zoneReponses.innerHTML = "";

  question[1].forEach((texte, index) => {
    const bouton = document.createElement("button");
    bouton.className = "answer-button";
    bouton.textContent = texte;
    bouton.addEventListener("click", () => verifierReponse(index));
    zoneReponses.appendChild(bouton);
  });

  const retour = document.getElementById("feedback");
  retour.textContent = "";
  retour.className = "feedback";

  document.getElementById("hint").textContent = "";
  document.getElementById("hint-button").disabled = false;
  document.getElementById("next-button").classList.add("hidden");

  mettreAJourTemps();

  chronometre = setInterval(() => {
    tempsRestant--;
    mettreAJourTemps();

    if (tempsRestant <= 0) {
      clearInterval(chronometre);

      if (!reponseVerrouillee) {
        verifierReponse(-1);
      }
    }
  }, 1000);
}

function mettreAJourTemps() {
  const affichage = document.getElementById("timer");

  if (affichage) {
    affichage.textContent = `⏱ ${tempsRestant} s`;
    affichage.classList.toggle("danger", tempsRestant <= 5);
  }
}

function verifierReponse(choix) {
  if (reponseVerrouillee) return;

  reponseVerrouillee = true;
  clearInterval(chronometre);

  const question = questionsPartie[indexQuestion];
  const bonneReponse = question[2];
  const boutons = document.querySelectorAll(".answer-button");
  const retour = document.getElementById("feedback");

  boutons.forEach((bouton, index) => {
    bouton.disabled = true;

    if (index === bonneReponse) {
      bouton.classList.add("correct");
    }

    if (index === choix && choix !== bonneReponse) {
      bouton.classList.add("incorrect");
    }
  });

  const estCorrect = choix === bonneReponse;

  if (estCorrect) {
    score++;
    retour.textContent = `✅ Bonne réponse ! ${question[3]}`;
    retour.classList.add("success");
  } else if (choix === -1) {
    retour.textContent =
      `⏰ Temps écoulé ! Bonne réponse : ${question[1][bonneReponse]}. ${question[3]}`;
    retour.classList.add("error");
  } else {
    retour.textContent =
      `❌ Mauvaise réponse. Bonne réponse : ${question[1][bonneReponse]}. ${question[3]}`;
    retour.classList.add("error");
  }

  reponsesJoueur.push({
    question: question[0],
    choix: choix === -1 ? "Aucune réponse" : question[1][choix],
    bonneReponse: question[1][bonneReponse],
    explication: question[3],
    indice: question[4],
    correct: estCorrect
  });

  document.getElementById("score").textContent = `Score : ${score}`;
  document.getElementById("next-button").classList.remove("hidden");
  document.getElementById("hint-button").disabled = true;
}

function afficherIndice() {
  if (reponseVerrouillee) return;

  const question = questionsPartie[indexQuestion];
  document.getElementById("hint").textContent = `💡 Indice : ${question[4]}`;
  document.getElementById("hint-button").disabled = true;
}

function questionSuivante() {
  if (!reponseVerrouillee) return;

  indexQuestion++;

  if (indexQuestion >= questionsPartie.length) {
    terminerPartie();
  } else {
    afficherQuestion();
  }
}

function terminerPartie() {
  clearInterval(chronometre);

  jeu.classList.add("hidden");
  resultat.classList.remove("hidden");

  const total = questionsPartie.length;
  const pourcentage = Math.round((score / total) * 100);

  document.getElementById("final-score").textContent = `${score}/${total}`;
  document.getElementById("percentage").textContent = `${pourcentage}%`;

  let message;

  if (pourcentage === 100) {
    message = "🏆 Incroyable ! Score parfait !";
  } else if (pourcentage >= 80) {
    message = "🌟 Excellent travail !";
  } else if (pourcentage >= 60) {
    message = "👏 Très bien ! Continue à progresser.";
  } else if (pourcentage >= 40) {
    message = "💪 Tu progresses ! Révise les réponses et réessaie.";
  } else {
    message = "📚 Ne baisse pas les bras : chaque partie t'apprend quelque chose.";
  }

  document.getElementById("result-message").textContent = message;

  const cle = "renovaQuizMeilleurScore";
  const ancien = Number(localStorage.getItem(cle) || 0);

  if (score > ancien) {
    localStorage.setItem(cle, String(score));
  }

  document.getElementById("best-score").textContent =
    `Meilleur score enregistré : ${localStorage.getItem(cle) || 0}`;

  const revision = document.getElementById("review");
  revision.innerHTML = "";

  reponsesJoueur.forEach((reponse, index) => {
    const bloc = document.createElement("article");
    bloc.className = "review-item";

    const titre = document.createElement("h3");
    titre.textContent = `${index + 1}. ${reponse.question}`;

    const choix = document.createElement("p");
    choix.textContent = `Ta réponse : ${reponse.choix}`;

    const bonne = document.createElement("p");
    bonne.textContent = `Bonne réponse : ${reponse.bonneReponse}`;

    const explication = document.createElement("p");
    explication.textContent = reponse.explication;

    bloc.append(titre, choix, bonne, explication);
    revision.appendChild(bloc);
  });
}

function revenirAccueil() {
  clearInterval(chronometre);

  jeu.classList.add("hidden");
  resultat.classList.add("hidden");
  accueil.classList.remove("hidden");
}

function rejouer() {
  commencerPartie(categorieActuelle);
}

document.getElementById("hint-button").addEventListener("click", afficherIndice);
document.getElementById("next-button").addEventListener("click", questionSuivante);
document.getElementById("home-button").addEventListener("click", revenirAccueil);
document.getElementById("replay-button").addEventListener("click", rejouer);
document.getElementById("result-home-button").addEventListener("click", revenirAccueil);

afficherCategories();
</script>
</body>
</html>
